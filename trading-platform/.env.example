APP_ENV=development
PORT=8787
STATIC_DIR=../web/dist
# Optional: override external runtime env file path (default: ~/.config/northstar/runtime.env).
# NORTHSTAR_ENV_FILE=/absolute/path/to/northstar/runtime.env
# Optional: store the SQLite database outside this Vault.
# NORTHSTAR_DATABASE_PATH=/absolute/path/to/northstar/terminal.sqlite3

# Names only. Store real credentials outside this Vault (e.g. ~/.config/northstar/runtime.env, chmod 600).
# Longbridge OpenAPI credentials (all three are required for real quotes & candles).
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
