APP_ENV=development
TRADING_MODE=paper
PORT=8787
STATIC_DIR=../web/dist
# Optional: store the SQLite database outside this Vault.
# NORTHSTAR_DATABASE_PATH=/absolute/path/to/northstar/terminal.sqlite3

# Names only. Store real credentials outside this Vault.
# Longbridge OpenAPI credentials. Leave blank to show an unconfigured state.
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=

# Schwab Trader API production credentials. Leave blank in paper mode.
SCHWAB_API_BASE_URL=https://api.schwabapi.com
SCHWAB_ACCESS_TOKEN=
SCHWAB_ACCOUNT_HASH=

# Required for live orders. Never commit the real value.
LIVE_ORDER_CONFIRMATION=
